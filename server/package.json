{
  "name": "shibboleth-discord-auth",
  "version": "3.0.1",
  "description": "",
  "main": "dist/node.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/node.ts",
    "start": "node dist/node.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker:dev": "wrangler dev src/worker.ts --local",
    "worker:deploy": "tsx src/scripts/deploy-worker.ts",
    "db:migrate:local": "tsx src/scripts/migrate-d1.ts --local",
    "db:migrate:remote": "tsx src/scripts/migrate-d1.ts --remote",
    "worker:secrets:set": "tsx src/scripts/set-worker-secrets.ts",
    "discord:commands:register": "tsx src/scripts/register-discord-commands.ts"
  },
  "keywords": [
    "shibboleth",
    "discord"
  ],
  "author": "SIGPwny",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@node-saml/node-saml": "^5.1.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.1.4",
    "hono": "^4.13.3",
    "jose": "^5.10.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.0",
    "wrangler": "^4.145.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
