{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shibboleth-link-api",
  "main": "src/worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "routes": [
    {
      "pattern": "dev-shib.sigpwny.com/*",
      "zone_name": "sigpwny.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shibboleth-link-dev",
      "database_id": "99a787c5-563c-4143-aae1-392e4c0ce077"
    }
  ],
  "vars": {}
}
