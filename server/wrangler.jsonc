{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shibboleth-link",
  "main": "src/worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["0 * * * *", "0 0 2 7 *", "0 0 25 7 *"]
  },
  "routes": [
    {
      "pattern": "shib.sigpwny.com/*",
      "zone_name": "sigpwny.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shibboleth-link",
      "database_id": "4d73cd43-77f5-4959-9953-a14a665234f0"
    }
  ],
  "vars": {}
}
