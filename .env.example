# Public app origin for local/self-hosted Node deployments.
# Cloudflare Workers derive this from the request hostname.
APP_ORIGIN=https://shibboleth-link.example.com

# Discord application and bot credentials.
DISCORD_BOT_TOKEN=replace-me
DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
DISCORD_PUBLIC_KEY=replace-me

# Cookie/session encryption secret. Use a long random value.
JWT_SECRET=replace-me

# SAML configuration.
SAML_ENTRY_POINT=https://shibboleth.illinois.edu/idp/profile/SAML2/Redirect/SSO
SAML_ISSUER=https://shibboleth-link.example.com/shibboleth

# SAML cert/key. These may also be read from files under server/data/shibboleth/.
SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
SAML_SP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Operator command scope. These are Worker secrets in Cloudflare and env vars locally.
OPERATOR_GUILD_ID=replace-me
OPERATOR_CHANNEL_ID=replace-me

# Optional local/self-hosted settings.
PORT=8787
SQLITE_PATH=server/data/local.sqlite

# Optional Cloudflare deploy token for Wrangler commands.
CLOUDFLARE_API_TOKEN=replace-me
